rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    function unchanged(keys) { return !request.resource.data.diff(resource.data).affectedKeys().hasAny(keys); }

    // ---- Users: students can never promote themselves ----
    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid)
        && request.resource.data.role == 'student'
        && request.resource.data.isPremium == false;
      allow update: if (isOwner(uid) && unchanged(['role', 'isPremium', 'premiumUntil', 'banned', 'createdAt'])) || isAdmin();
      allow delete: if isAdmin();

      match /bookmarks/{id} { allow read, write: if isOwner(uid); }
      match /enrollments/{courseId} {
        allow read: if isOwner(uid) || isAdmin();
        // Self-enrol only into FREE, non-premium courses. Paid access is granted by an admin.
        allow create: if isAdmin() || (isOwner(uid)
          && get(/databases/$(database)/documents/courses/$(courseId)).data.get('price', 0) == 0
          && get(/databases/$(database)/documents/courses/$(courseId)).data.get('isPremium', false) == false);
        allow update, delete: if isAdmin();
      }
    }

    // ---- Public learning content (read by everyone signed in) ----
    match /content/{id}     { allow read: if signedIn(); allow write: if isAdmin(); }
    match /categories/{id}  { allow read: if signedIn(); allow write: if isAdmin(); }
    match /quizBank/{id}    { allow read: if signedIn(); allow write: if isAdmin(); }
    match /vocabulary/{id}  { allow read: if signedIn(); allow write: if isAdmin(); }
    match /config/{id}      { allow read: if signedIn(); allow write: if isAdmin(); }

    match /courses/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
      match /lessons/{l}      { allow read: if signedIn(); allow write: if isAdmin(); }
      match /assignments/{a} {
        allow read: if signedIn();
        allow write: if isAdmin();
        match /submissions/{uid} { allow create, update: if isOwner(uid); allow read: if isOwner(uid) || isAdmin(); }
      }
    }

    match /liveClasses/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
      match /chat/{m} {
        allow read: if signedIn();
        allow create: if signedIn() && request.resource.data.uid == request.auth.uid
          && request.resource.data.text is string && request.resource.data.text.size() <= 500;
        allow delete: if isAdmin();
      }
      match /attendance/{uid} { allow create, update: if isOwner(uid); allow read: if isOwner(uid) || isAdmin(); }
      match /assignments/{a} {
        allow read: if signedIn();
        allow write: if isAdmin();
        match /submissions/{uid} { allow create, update: if isOwner(uid); allow read: if isOwner(uid) || isAdmin(); }
      }
    }

    // ---- Exams & results ----
    match /exams/{id} { allow read: if signedIn(); allow write: if isAdmin(); }
    match /results/{id} {
      allow read: if signedIn();   // leaderboard needs cross-user reads (names + scores only)
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update: if isAdmin();  // admin grades written exams
      allow delete: if isAdmin();
    }

    // ---- Payments: user submits a pending request, only admin can approve ----
    match /payments/{id} {
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid && request.resource.data.status == 'pending';
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    // ---- Analytics counters: signed-in users may only increment daily docs ----
    match /stats/{id} {
      allow read: if isAdmin();
      allow write: if signedIn() && id.matches('daily_[0-9]{8}');
    }

    // Written only by Cloud Functions (admin SDK bypasses rules).
    match /aiUsage/{id} { allow read, write: if false; }
  }
}
